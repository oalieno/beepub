# Everything in this file is optional — BeePub starts with no .env at all.

# PostgreSQL. The database is only reachable inside the compose network;
# uncomment to override the defaults.
#POSTGRES_DB=beepub
#POSTGRES_USER=beepub
#POSTGRES_PASSWORD=changeme

# JWT signing secret. Left unset, one is auto-generated on first start and
# persisted in the app_data volume. Set it explicitly (openssl rand -hex 32)
# to control or rotate it — changing it logs every session out.
#SECRET_KEY=

# Pin the image version instead of tracking latest (e.g. 0.1.0)
#BEEPUB_VERSION=latest

# Access token lifetime in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Logging format: "console" (pretty, colored) or "json" (machine-readable)
LOG_FORMAT=console

# App port (nginx)
PORT=80

# CORS: comma-separated list of public web origins allowed to call the API.
# Capacitor (capacitor://localhost, ionic://localhost) and localhost browser
# origins on any port are always allowed.
# Example: CORS_ORIGINS=https://beepub.example.com,https://reader.example.com
CORS_ORIGINS=
